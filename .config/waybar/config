{
  "layer": "top",
  "position": "top",
  "ipc": true,                   
  "id_mode": "modifier", 
  "height": 40,

  "margin-top": 0,
  "margin-left": 200,
  "margin-right": 200,

  "modules-left": [
    "custom/launcher",
    "sway/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "sway/language",
    "network",
    "pulseaudio",
    "custom/power"
  ],
 
  "custom/launcher": {
    "format": "",
    "tooltip": "Apps",
    "on-click": "fuzzel"
  },

"sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": []
    }
  },
    "sway/language": {
    "device": "keyboard",
    "format": "  {short} ",
    "tooltip": false
},

  "clock": {
    "format": "  {:%a  %d %b   %H:%M}"    
    },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰌘 lan",
    "format-disconnected": " Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}"
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },

  "custom/power": {
    "format": " ",
    "on-click": "wlogout",
    "tooltip": true,
    "tooltip-format": "wlogout"
  }

}
